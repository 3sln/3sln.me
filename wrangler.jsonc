{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "3sln-me",
  "main": "apps/worker/index.mjs",
  "account_id": "160b9c59cb80a1a5a4f391dfc5be9aca",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "keep_vars": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "3sln.me",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PLAN_CATALOG",
        "class_name": "PlanCatalogObject"
      },
      {
        "name": "IDENTITIES",
        "class_name": "IdentityDirectory"
      },
      {
        "name": "ACCOUNTS",
        "class_name": "AccountObject"
      },
      {
        "name": "ABUSE",
        "class_name": "AbuseGuard"
      },
      {
        "name": "SEMANTIC_BUDGET",
        "class_name": "SemanticBudgetObject"
      },
      {
        "name": "MCP_AUTH",
        "class_name": "McpAuthorizationObject"
      },
      {
        "name": "FEDERATION",
        "class_name": "FederationObject"
      },
      {
        "name": "ADMIN_AUTHORITY",
        "class_name": "AdminAuthority"
      },
      {
        "name": "LIFECYCLE_SCHEDULER",
        "class_name": "LifecycleScheduler"
      },
      {
        "name": "EVENT_BUS_WAITS",
        "class_name": "EventBusWaiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "IdentityDirectory",
        "AccountObject",
        "AbuseGuard"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "SemanticBudgetObject"
      ]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": [
        "McpAuthorizationObject"
      ]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": [
        "FederationObject"
      ]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": [
        "PlanCatalogObject"
      ]
    },
    {
      "tag": "v6",
      "new_sqlite_classes": [
        "AdminAuthority"
      ]
    },
    {
      "tag": "v7",
      "new_sqlite_classes": [
        "LifecycleScheduler"
      ]
    },
    {
      "tag": "v8",
      "new_sqlite_classes": [
        "EventBusWaiter"
      ]
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "3sln-me-blobs"
    },
    {
      "binding": "ARCHIVES",
      "bucket_name": "3sln-me-account-archives"
    }
  ],
  "triggers": {
    "crons": [
      "17 */6 * * *"
    ]
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": [
        "verify@sys.3sln.me",
        "login@sys.3sln.me",
        "notify@sys.3sln.me",
        "accounts@sys.3sln.me",
        "security@sys.3sln.me"
      ]
    }
  ],
  "vars": {
    "EXTENSIONS_ENABLED": "false",
    "INTEGRATIONS_ENABLED": "false",
    "BROKERING_ENABLED": "false",
    "DEVICE_AUTHORIZATION_ENABLED": "false",
    "ACTIVITY_V2_ENABLED": "false",
    "BINDLEBOX_ENABLED": "false",
    "EVENT_BUSES_ENABLED": "false",
    "INCREMENTAL_AUTH_ENABLED": "false",
    "LIFECYCLE_ENABLED": "false",
    "LIFECYCLE_DRY_RUN": "true",
    "LIFECYCLE_PURGE_ENABLED": "false",
    "LIFECYCLE_COLD_STORAGE": "true",
    "LIFECYCLE_COLD_MIN_BYTES": "4194304",
    "LIFECYCLE_FINANCE_REVIEW": "polar",
    "LIFECYCLE_SWEEP_BATCH": "200",
    "GOOGLE_CLIENT_ID": "88558903900-8r8m0igv5bceo4k6r5j7nvfd3jlgckmj.apps.googleusercontent.com",
    "APP_ORIGIN": "https://3sln.me",
    "LOCAL_DEVELOPMENT": "false",
    "BRAND_NAME": "3sln.me",
    "RP_ID": "3sln.me",
    "TERMS_VERSION": "2026-10-11",
    "RELEASE_READY": "false",
    "SIGNUP_ENABLED": "true",
    "SIGNUP_CONTACT_REQUIRED": "true",
    "BILLING_ENABLED": "true",
    "POLAR_SERVER": "production",
    "POLAR_METADATA_PREFIX": "3sln_me_",
    "POLAR_CATALOG_MODE": "metadata",
    "POLAR_ORGANIZATION_ID": "1e5a5f06-5c12-4dfd-9683-c1e08c4ba8a1",
    "POLAR_PRODUCT_ID_PAID": "c3d5fd76-8330-4e2c-b1ec-4ee90555b994",
    "POLAR_PRODUCT_ID_PLUS": "21634e36-3690-4264-bd59-80a898e4f5a4",
    "POLAR_PRODUCT_ID_ULTRA": "a494de77-5e43-4daa-8e9d-201866705d8a",
    "MAIL_ENABLED": "true",
    "MAIL_SENDER_DOMAIN": "sys.3sln.me",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFVvoNPzDOikJ-Is",
    "ALLOWED_CONNECTOR_HOSTS": "",
    "PUSH_ENABLED": "true",
    "VAPID_PUBLIC_KEY": "BAkYIAmDFSAZASaOp9-Lpa9hhbyyVGB5Dwr5l8-he5PORnFLoJ1i-USViI25odtz6kNxF9gkrGOtmBu9N_Nxme4",
    "SEMANTIC_SEARCH_ENABLED": "true",
    "SEMANTIC_EMBEDDING_MODEL": "@cf/baai/bge-small-en-v1.5",
    "SEMANTIC_GLOBAL_MONTHLY_MICRO_USD": "5000000",
    "SEMANTIC_GLOBAL_DAILY_MICRO_USD": "500000",
    "SEMANTIC_GLOBAL_MAX_OWNERS": "1000",
    "SEMANTIC_GLOBAL_MAX_UPSERTS": "2000000",
    "SIGNUP_IP_WINDOW_MS": "10800000",
    "SIGNUP_IP_DAILY_LIMIT": "2",
    "SIGNUP_SUBNET_DAILY_LIMIT": "15",
    "SIGNUP_REGION_HOURLY_LIMIT": "5",
    "SIGNUP_REGION_DAILY_LIMIT": "25",
    "SIGNUP_GLOBAL_HOURLY_LIMIT": "10",
    "SIGNUP_GLOBAL_DAILY_LIMIT": "200",
    "SIGNUP_MAX_ADMISSIONS": "100000",
    "SIGNUP_FREE_MAX_ADMISSIONS": "10000",
    "PAID_SIGNUP_ENABLED": "true",
    "WAITLIST_ENABLED": "true",
    "IDENTITY_LAYOUT": "v1-64-fresh",
    "BEAM_ENABLED": "true",
    "BEAM_MONTHLY_DELIVERY_BYTES": "1000000000",
    "BEAM_MONTHLY_OFFERS": "20",
    "BEAM_TURN_ENABLED": "false",
    "CLOUDFLARE_TURN_KEY_ID": "",
    "BEAM_STUN_ENABLED": "true",
    "WORK_LIMITS_ENABLED": "true",
    "STORAGE_WRITE_ENABLED": "true",
    "STORAGE_WRITE_SERVICE_MONTHLY_LIMIT": "10000000",
    "STORAGE_WRITE_FREE_PER_HOUR": "500",
    "STORAGE_WRITE_FREE_PER_DAY": "1000",
    "STORAGE_WRITE_PAID_PER_HOUR": "2000",
    "STORAGE_WRITE_PAID_PER_DAY": "10000",
    "STORAGE_WRITE_OWNER_PER_MINUTE": "240",
    "STORAGE_WRITE_APP_PER_MINUTE": "120",
    "STORAGE_WRITE_MAINTENANCE_MONTHLY_LIMIT": "16",
    "STORAGE_WRITE_MAINTENANCE_PERCENT": "10",
    "MCP_ENABLED": "false",
    "MCP_LAYOUT": "mcp-auth-v1-64",
    "MCP_CLIENTS": "[]",
    "FEDERATION_ENABLED": "false",
    "FEDERATION_CLIENTS": "[]",
    "CLIENT_METADATA_ENABLED": "false",
    "FEDERATION_SCHEMAS": "{}",
    "FORM_POSTBACK_ORIGINS": "[]",
    "APP_NOTIFICATION_PUBLIC_JWKS": "{\"keys\":[{\"key_ops\":[\"verify\"],\"ext\":true,\"kty\":\"EC\",\"x\":\"cUmSplKJG66MHucYQCrhQjvv3Y_YPz2xIp6XDk2XvgY\",\"y\":\"6HOH5pa8je6a6Yg6NJLi_2qVzM-WgJ9kr_mjoOQ_rWo\",\"crv\":\"P-256\",\"kid\":\"app-message-14e5a76a-8557-41dc-a705-7462d6c165d8\",\"alg\":\"ES256\",\"use\":\"sig\"}]}"
  },
  "observability": {
    "enabled": false
  },
  "limits": {
    "cpu_ms": 100
  },
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "SEARCH_VECTORS_0",
      "index_name": "bindle-search-bge-small-v1"
    },
    {
      "binding": "SEARCH_VECTORS_1",
      "index_name": "bindle-search-bge-small-v1-s1"
    },
    {
      "binding": "SEARCH_VECTORS_2",
      "index_name": "bindle-search-bge-small-v1-s2"
    },
    {
      "binding": "SEARCH_VECTORS_3",
      "index_name": "bindle-search-bge-small-v1-s3"
    }
  ]
}
