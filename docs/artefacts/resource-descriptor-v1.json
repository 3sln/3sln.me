{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://3sln.me/artefacts/contracts/resource-descriptor/v1",
  "title": "Describe only currently approved resource methods",
  "description": "Validates the contract method/args projection of a Bindle RPC envelope. The RPC transport and live authority are defined separately. Initial runtime profile; publish changes under a new URL.",
  "type": "object",
  "required": [
    "method",
    "args"
  ],
  "properties": {
    "method": {
      "const": "describe"
    },
    "args": {
      "type": "object",
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "result": {
      "type": "object",
      "required": [
        "id",
        "contracts",
        "limits"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uri"
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "contracts": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 64
            },
            "maxItems": 32
          }
        },
        "limits": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  },
  "x-methods": {
    "describe": {
      "request": "#",
      "result": "#/$defs/result",
      "effect": "read",
      "permission": "Approved fields and live resource assignment for this exact contract/method."
    }
  }
}
