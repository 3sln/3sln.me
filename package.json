{
  "name": "bindle-reference",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:worker",
    "test": "node --test tests/*.test.mjs packages/sdk/test/*.test.mjs",
    "test:worker": "node --test tests/worker/*.test.mjs",
    "test:dom": "node --experimental-loader ./tests/browser/loader.mjs tests/browser/smoke.mjs",
    "dev:demo": "node apps/server/server.mjs",
    "build:assets": "node scripts/build-assets.mjs",
    "dev:worker": "npm run build:assets && wrangler dev --config wrangler.local.jsonc --port 8787",
    "check:worker": "npm run build:assets && wrangler deploy --dry-run --outdir .output/worker",
    "dev:node": "npm run build:assets && node apps/node/server.mjs",
    "test:e2e": "node scripts/run-browser-checks.mjs",
    "test:ui-state": "node --experimental-loader ./tests/browser/loader.mjs --test tests/browser/release-state.mjs tests/browser/plans-search.mjs tests/browser/beaming.mjs tests/browser/beaming-security.mjs tests/browser/mcp-conversations.mjs tests/browser/owner-flow-audit.mjs tests/browser/app-connections.mjs tests/browser/browser-automation.mjs tests/browser/google-drive.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "chrome-devtools-mcp": "1.10.1",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.1",
    "marked": "18.1.0",
    "playwright": "1.64.0",
    "wrangler": "4.149.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@polar-sh/sdk": "1.0.2",
    "@simplewebauthn/server": "14.0.3",
    "aws4fetch": "1.0.20",
    "hash-wasm": "4.12.0",
    "parse5": "8.0.1",
    "qrcode": "1.5.4",
    "standardwebhooks": "1.1.1",
    "web-push": "3.6.7",
    "zod": "4.6.6"
  }
}
